{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "exec",
            "oxfmt",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
