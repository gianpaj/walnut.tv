{
  "name": "walnut.tv",
  "version": "2.0.0",
  "private": true,
  "description": "Always Interesting Videos (webapp)",
  "homepage": "https://walnut.tv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gianpaj/walnut.tv.git"
  },
  "bugs": {
    "url": "https://github.com/gianpaj/walnut.tv/issues"
  },
  "author": "Gianfranco Palumbo, Alexander Kostinskyi",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "dev": "PORTLESS_TLD=localhost PORTLESS_LAN=0 portless walnut next dev --hostname 127.0.0.1",
    "dev:direct": "next dev",
    "build": "pnpm check-channels && next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "format": "oxfmt --write . && pnpm format:markdown",
    "format:markdown": "prettier --write \"**/*.{md,mdx}\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.{md,mdx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "check-channels": "node scripts/check-channels.js",
    "watch-channels": "nodemon scripts/check-channels.js"
  },
  "dependencies": {
    "@googleapis/youtube": "^33.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-resizable-panels": "^3.0.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/youtube": "^0.3.0",
    "autoprefixer": "^10.4.22",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "nodemon": "^3.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "portless": "0.15.6",
    "postcss": "^8.5.25",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^7.0.2",
    "yup": "^1.7.1"
  }
}
