# YouTube Data API v3 key. Server-only since phase 2 — it is no longer sent to
# the browser, so restrict it by IP rather than by HTTP referrer.
YOUTUBE_API_KEY="YOUR_API_KEY"

# Only needed while the key is still restricted to HTTP referrers, which a
# server-side request cannot satisfy (the API answers 403 "Requests from
# referer <empty> are blocked"). Prefer changing the key restriction instead.
# YOUTUBE_API_REFERER="https://walnut.tv/"

# Deprecated: still read as a fallback, but it exposes the key to every visitor.
# NEXT_PUBLIC_YOUTUBE_API_KEY="YOUR_API_KEY"
