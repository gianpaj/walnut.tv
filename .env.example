# YouTube Data API v3 key.
# Exposed to the browser today because fetching happens client-side.
# Phase 2 of MIGRATION-PLAN.md moves fetching server-side, at which point this
# becomes a server-only YOUTUBE_API_KEY.
NEXT_PUBLIC_YOUTUBE_API_KEY="YOUR_API_KEY"

# Used by scripts/add-youtube-channel.js and scripts/extract-youtube-channel-id.js
YOUTUBE_API_KEY="YOUR_API_KEY"
